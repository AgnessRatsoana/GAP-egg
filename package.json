{
  "name": "gap-a-month",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "dev:web": "npm run dev --workspace=@gap-month/web",
    "dev:backend": "npm run dev --workspace=@gap-month/backend",
    "dev:mobile": "npm run dev --workspace=@gap-month/mobile"
  },
  "dependencies": {
    "turbo": "^2.5.8"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
